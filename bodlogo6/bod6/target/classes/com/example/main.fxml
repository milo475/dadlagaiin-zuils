<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="380.0" prefWidth="500.0" spacing="10"
      xmlns="http://javafx.com/javafx/25.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.mainController">
   <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
   <children>
      <TextArea prefHeight="200.0" prefWidth="480.0" editable="false"
                text="RGB7070 - Нийлбэр 1&#10;&#10;Өгөгдсөн натурал тоо n хүртэлх натурал тоонуудын нийлбэрийг ол.&#10;&#10;Давталт ашиглахгүй болно.&#10;&#10;Input: Натурал тоо n өгөгдөнө.&#10;Output: Нийлбэр&#10;&#10;Example&#10;Input: 10&#10;Output: 55">
         <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
      </TextArea>
      <TextField fx:id="txtInput" promptText="input" prefWidth="480.0" style="-fx-background-radius: 50;"/>
      <Button fx:id="txtShalgah" text="Шалгах" onAction="#shalgah"
              style="-fx-background-radius: 50;" prefWidth="480.0"/>
      <TextField fx:id="txtOutput" promptText="output" prefWidth="480.0"
                 editable="false" style="-fx-background-radius: 50;"/>
   </children>
</VBox>
