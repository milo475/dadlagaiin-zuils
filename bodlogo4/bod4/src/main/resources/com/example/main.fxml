<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="280.0" prefWidth="500.0" style="-fx-background-color: B2BEB5;" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mainController">
   <children>
      <TextArea fx:id="txtInput" layoutX="10.0" layoutY="10.0" prefHeight="180.0" prefWidth="480.0" editable="false"
                text="RGB7031 - Гурвалжны талбай&#10;&#10;Гурвалжны гурван тал өгөгдсөн бол талбайг нь ол.&#10;&#10;Input: Нэг мөрөнд зайгаар тусгаарлагдан 3 тал бодит тоогоор өгөгдөнө.&#10;Output: Талбайг таслалаас хойш 2 орны нарийвчлалтай дүрсэл.">
         <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
      </TextArea>
      <TextField fx:id="txtUserInput" layoutX="10.0" layoutY="210.0" prefWidth="200.0" promptText="input" style="-fx-background-radius: 50;" />
      <Button fx:id="btnShalgah" layoutX="220.0" layoutY="210.0" mnemonicParsing="false" onAction="#shalgah" style="-fx-background-radius: 50;" text="Шалгах" />
      <TextField fx:id="txtOutput" layoutX="310.0" layoutY="210.0" prefWidth="180.0" promptText="output" style="-fx-background-radius: 50;" editable="false"/>
   </children>
</AnchorPane>
