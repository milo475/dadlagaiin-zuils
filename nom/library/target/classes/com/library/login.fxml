<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="16" prefWidth="340" prefHeight="300"
      style="-fx-background-color:#f0f4f8;-fx-padding:40"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/11"
      fx:controller="com.library.LoginController">

  <Label text="📚 Номын сан" style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#3d6b8e"/>
  <Separator/>

  <Label text="Нэвтрэх нэр"/>
  <TextField fx:id="txtUsername" promptText="username" prefWidth="220"/>

  <Label text="Нууц үг"/>
  <PasswordField fx:id="txtPassword" promptText="password" prefWidth="220"/>

  <Label fx:id="lblError" text="" style="-fx-text-fill:red"/>

  <Button text="Нэвтрэх" onAction="#handleLogin"
          style="-fx-background-color:#3d6b8e;-fx-text-fill:white;-fx-pref-width:220;-fx-font-size:14"
          defaultButton="true"/>
</VBox>
